# Worktree directories and workspace labels already identify the branch.
HERDR_AUTO_TITLE_BRANCH_MAX=0

# Keep tab positions visible for keyboard navigation.
HERDR_AUTO_TITLE_POSITION=true

# Use agent context for meaningful Claude Code and Codex titles.
HERDR_AUTO_TITLE_TRANSCRIPT=true
HERDR_AUTO_TITLE_AGENT_NAME=true
HERDR_AUTO_TITLE_PANES=true

# Worktrunk owns workspace naming; Auto Title only names tabs and panes.
HERDR_AUTO_TITLE_WORKSPACES=false
