# This is Git's per-user configuration file.
[credential]
	helper = osxkeychain

[merge]
	tool = nvimdiff3
  conflictStyle = zdiff3

[mergetool]
	keepBackup = false
	prompt = true

[mergetool "vscode"]
	cmd = code --wait $MERGED

[mergetool "nvimdiff4"]
	cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[mergetool "nvimdiff3"]
	cmd = "nvim -d -c \"wincmd l\" -c \"norm ]c\" \"$LOCAL\" \"$MERGED\" \"$REMOTE\""

[diff]
  algorithm = patience
	compactionHeuristic = true
	tool = nvimdiff

[difftool "vscode"]
	cmd = code --wait --diff

[difftool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\" -c \"wincmd w\" -c \"wincmd L\"

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
  dark = true


[core]
	autocrlf = input
  pager = delta

[pull]
	rebase = false

[init]
	defaultBranch = master

[push]
  default = current
	autoSetupRemote = true

[commit]
	gpgsign = true

